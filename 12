import sys

def primsAlgo(graph, n):
    selected = [False] * n
    selected[0] = True
    edges = 0
    print("Edge : Weight")
    
    while edges < n - 1:
        minimum = sys.maxsize
        x = 0
        y = 0
        
        for i in range(n):
            if selected[i]:
                for j in range(n):
                    if (not selected[j]) and graph[i][j]:
                        if minimum > graph[i][j]:
                            minimum = graph[i][j]
                            x = i
                            y = j
                            
        print(f"{x} - {y} : {graph[x][y]}")
        selected[y] = True
        edges += 1

# Example: subnet with 4 hosts and given cost adjacency matrix
n = 4
graph = [
    [0, 1, 3, 0],
    [1, 0, 2, 4],
    [3, 2, 0, 5],
    [0, 4, 5, 0]
]

primsAlgo(graph, n)



